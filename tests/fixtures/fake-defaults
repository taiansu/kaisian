#!/bin/bash
set -u

log_file="${KAISIAN_DEFAULTS_LOG:-}"
if test -n "$log_file"; then
  /bin/mkdir -p "$(/usr/bin/dirname "$log_file")" 2>/dev/null || true
  printf '%s\n' "$*" >> "$log_file"
fi

if test $# -gt 0 && test "$1" = "read"; then
  if test -n "${KAISIAN_DEFAULTS_READ_OUTPUT-}"; then
    printf '%s\n' "$KAISIAN_DEFAULTS_READ_OUTPUT"
    exit 0
  fi
  if test "${KAISIAN_DEFAULTS_READ_EMPTY:-0}" = '1'; then
    exit 1
  fi
  exit 0
fi

if test "${KAISIAN_DEFAULTS_FAIL:-0}" = '1'; then
  exit 1
fi

exit 0
